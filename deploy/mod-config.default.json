{
  "voice": {
    "mapFullVolumeDistance": 5,
    "mapMaximumDistance": 20,
    "sceneFullVolumeDistance": 10,
    "sceneMaximumDistance": 50
  },
  // Bannerlord Coop gameplay configuration — owned by the Coop mod itself and
  // applied wherever the coop server runs (dedicated server or player-hosted
  // session). Settings for how a dedicated server PROCESS runs (save name,
  // password, ports, autosaves) live in the dedicated server's own
  // DedicatedServer\server-config.json instead. Comments and trailing commas
  // are allowed here.
  // The server adds settings from new mod versions to this file when it loads,
  // so a deleted setting comes back with its default value. Comment a setting
  // out with // instead to keep it out of the file.

  // Campaign difficulty, applied by the HOSTING side at every boot; joining
  // players inherit the values with the save transfer. These values mirror a
  // newly created vanilla Bannerlord campaign.
  // Levels: "VeryEasy" | "Easy" | "Realistic".
  "difficulty": {
    // Damage players take. VeryEasy is Bannerlord's new-campaign default.
    // VeryEasy: -75% Damage
    // Easy: -50% Damage
    // Realistic: No change
    "playerReceivedDamage": "VeryEasy",

    // Determine the damage received by your troops.
    // VeryEasy: -50% Damage
    // Easy: -25% Damage
    // Realistic: No change
    "playerTroopsReceivedDamage": "VeryEasy",

    // Determine the difficulty of the combat AI.
    // VeryEasy: Normal
    // Easy: Veteran
    // Realistic: Challenging
    "combatAIDifficulty": "VeryEasy",

    // Determine the amount of troops available from notables.
    // VeryEasy: +2 Troops
    // Easy: +1 Troops
    // Realistic: No change
    "recruitmentDifficulty": "VeryEasy",

    // Determine player party movement speed while travelling.
    // VeryEasy: +10% Speed
    // Easy: +5% Speed
    // Realistic: No change
    "playerMapMovementSpeed": "VeryEasy",

    // Determine the difficulty of stealth and disguise gameplay.
    // VeryEasy: Normal
    // Easy: Veteran
    // Realistic: Challenging
    "stealthAndDisguiseDifficulty": "VeryEasy",

    // Determine persuasion success chance.
    // VeryEasy: +10% Success chance
    // Easy: +5% Success chance
    // Realistic: No change
    "persuasionSuccessChance": "VeryEasy",

    // Determine the possibility of player clan members dying in battle.
    // VeryEasy: Disabled battle death for clan members
    // Easy: Reduced by 50%
    // Realistic: No change
    "clanMemberDeathChance": "VeryEasy",

    // Determine if players and/or other heroes can die in battle.
    // VeryEasy: Disable battle death for all heroes
    // Easy: Disable battle death for player heroes
    // Realistic: Enable battle death for all heroes
    "battleDeath": "VeryEasy",

    // Toggle aging, births and natural deaths.
    // NOTE: Having this off doesn't necessarily disable battle deaths
    // To disable battle deaths change "battleDeath" and "clanMemberDeathChance" instead
    "birthAndDeath": true,

    // Toggle auto allocation of perks for members of player clans.
    "autoAllocateClanMemberPerks": false
  },

  // Advanced starting options offered to a player creating a new character on join.
  "advancedStart": {
    // (Default) true: a joining player picks between the default start and the start types below.
    // false: the window never shows and everyone gets the default start.
    "enabled": true,

    // The start type selected when the window opens: "default", "outlaw", "beggar",
    // "trader", "mercenary", "vassal" or "king".
    "defaultStartType": "default",

    // false hides a start type from the window.
    // trader, mercenary, vassal and king change the world (workshops, fiefs, kingdom
    // rulers, wars), so they can only be picked before the campaign is first resumed.
    // A kingdom a player already rules can't be taken with a king start. Vanilla's
    // single-player playthrough locks on king, vassal and mercenary don't apply here.
    "startTypes": {
      "outlaw": true,
      "beggar": true,
      "trader": true,
      "mercenary": true,
      "vassal": true,
      "king": true
    },

    // The most adult brothers and sisters a joining player can start with in their party.
    // Default is 3. Set to 0 to hide the option.
    "maxSiblings": 3
  },

  "modOptions": {
    // Enables proximity voice for every player. Runtime changes are session-only.
    "voiceEnabled": true,
    // Total human troops initially allocated across both sides of a battle.
    // Valid range: 200-1000. Default is 1000.
    "battleSize": 1000,

    // Toggle fast forward (2x speed) being enabled
    // (Default) true: Fast forward is allowed.
    // false: Fast forward is completely disabled.
    "fastForwardEnabled": true,

    // Toggle auto pausing
    // (Default) true: Pause when all players are occupied (in a battle, a settlement or the screens after a battle).
    // false: Auto pause is disabled. The game will still automatically pause for clients catching up and when there are no players online.
    "autoPauseEnabled": true,

    // Toggle players being able to pause or change the game speed
    // (Default) true: Any player can pause, play or fast forward.
    // false: Only the host (the server console or the dedicated server manager) can pause or change the speed.
    // The game still pauses by itself when players join or catch up, when nobody is online and for auto pause.
    // Players can't resume those pauses themselves. The pauses for catching up and auto pause end on their own,
    // but after the pause for nobody online the host has to start the game again.
    "allowClientTimeControls": true,

    // Toggle clients being able to use cheats
    // Vanilla bannerlord commands are always disabled on clients but this disables cheating in troops, equipment, teleporting etc.
    // Default is false.
    "clientsCanUseCheats": false,

    // Toggle Gold & food change while in settlements. THIS INCLUDES INCOME
    // (Default) false: Gold & food will remain the same while being in a settlement, including walking around the settlement, participating in tournaments etc.
    // true: Gold & food will change the same in settlements as on the campaign map.
    "goldFoodInfluenceChangeInSettlements": false,

    // Set gold & food change mode for battles. THIS INCLUDES INCOME
    // (Default) Disabled: No gold or food will change while in battles.
    // OneDayMax: Gold and food change can happen at most once during a battle. e.g. Only paying for troops once during a 15 day siege.
    // Enabled: Gold and food change happen regardless of whether a player is in a battle or not.
    "goldFoodInfluenceChangeInBattles": "Disabled",

    // Set gold, food & influence change for disconnected players. THIS INCLUDES INCOME
    // (Default) false: Disconnected players won't have any gold or food change.
    // true: Disconnected players have gold and food change.
    "goldFoodInfluenceChangeForDisconnectedPlayers": false,

    // Stop AI kingdoms from proposing new wars on players who are offline.
    // (Default) false: AI kingdoms propose wars as in vanilla.
    // true: The server refuses AI war proposals and alliance calls to war against a player-ruled kingdom or an independent player clan while none of its players are online.
    // Existing wars, rebellions, votes already in progress and player-proposed wars are not affected.
    "blockAiWarDeclarationsOnOfflinePlayers": false,

    // Set grace period (hours) for AI parties to be able to join battles involving players.
    // Default is 6, meaning AI parties can only join a player battle within 6 hours of it starting.
    // If set to 0, AI parties will not join in player battles.
    "playerBattleAiJoinWindowHours": 6,

    // Set how many real seconds AI parties leave a player alone after a battle.
    // (Default) 0: Off. AI parties can attack a player as soon as their battle ends.
    // Above 0: AI parties can't attack a player who is still in the loot, prisoner or other after battle screens,
    // or for this many seconds after the player leaves them. The seconds count while paused too, and game speed
    // doesn't change them. Other players can still attack.
    "postBattleAiAmnestySeconds": 0,

    // Toggle speed limit when players are in a battle.
    // Default is true, meaning the game will be locked at 1x speed when any player is in a battle.
    "speedLimitWhilePlayersInBattle": true,

    // Toggle ensuring there is always a certain population of wanderers/companions that are unaffiliated and can be recruited.
    // (Default) true: Use wandererLimit as the target unaffiliated wanderer population. Recruited wanderers DO NOT add to this limit.
    // false: The number of wanderers that can exist in total is equal to wandererLimit. Recruited wanderers DO add to this limit.
    "ensureUnaffiliatedWanderers": true,

    // Set the limit for wanderers/companions.
    // When ensureUnaffiliatedWanderers is true, this limit is the target number of unaffiliated wanderers to spawn.
    // When ensureUnaffiliatedWanderers is false, this sets the hardcap for the number of wanderers (including those already recruited).
    // Vanilla/default limit is numberOfTowns * 0.6 ≈ 32.
    "wandererLimit": 32,

    // Toggle scaling the wanderer/companion limit with the number of players on the campaign map.
    // (Default) false: Use above setting "wandererLimit" to set the cap of wanderers/companions that can exist.
    // true: Override "ensureUnaffiliatedWanderers" & "wandererLimit" to use a scaling cap with the number of players (including offline players).
    // This option starts at the vanilla limit of 32 and increases depending on the player count.
    // Each player's clan contributes to the total cap based on tier: 0, 0, 5, 5, 5, 10, 10
    // e.g. With 3 players: 1 at tier 0 adds 0, 1 at tier 2 adds 5, 1 at tier 5 adds 10. This results in 32 + 0 + 5 + 10 = 47.
    "wandererLimitScalesWithPlayers": false,

    // Set the rate of spawning new wanderers.
    // Vanilla/default is 1 wanderer per in-game day.
    // Setting this value lower than 1 means no more wanderer spawns.
    "spawnRateWanderers": 1,

    // Set a custom clan tier required to form a player kingdom.
    // Vanilla/default allows players to start kingdoms from clan tier 4 onwards.
    "playerKingdomClanTierRequired": 4,

    // Allows players to join another player's clan or propose a player marriage.
    // Disabling this does not dissolve existing coop clans.
    "coopClansEnabled": true,

    // Toggle recovering stamina outside of settlements.
    // In vanilla players have to wait in settlements to regenerate smithing stamina.
    // false: More like vanilla, players have to wait in settlements to get their smithing stamina back.
    // (Default) true: Players recovery stamina when moving around the world map as well in settlements.
    "smithingStaminaRecoveryOutsideSettlements": true,

    // Set a multiplier for increasing/decreasing smithing stamina recovery speed.
    // The vanilla rate is 1. The default for this mod is 0.6 as stamina regenerates in the smithing screen.
    // Setting it lower than 0.1 won't decrease speed more.
    // Stamina is stored as an integer and ticks are rounded up to ensure heroes always recover some stamina.
    "smithingStaminaRecoveryMultiplier": 0.6,

    // Set a multiplier for increasing/decreasing the number of looter/bandit parties.
    // The higher the multiplier, the more looter parties can exist on the map at a time.
    // WARNING: Setting this value too high will cause performance issues.
    // The default is 1, which is equivalent to the vanilla spawn limit.
    // Negative values will default back to 1.0
    "maximumLootersMultiplier": 1.0,

    // Set a multiplier for increasing/decreasing the size of looter/bandit parties.
    // The higher the multiplier, the more looters/bandits in these parties.
    // This only applies to new parties, existing bandit parties in a save game will not increase in size.
    // The default is 1, which is equivalent to the vanilla party size.
    // When quests are supported, bandit parties spawned by quests will not be affected.
    // Negative values will default back to 1.0
    "looterPartySizeMultiplier": 1.0,

    // How long a lord remembers refusing to defect to your kingdom.
    // Vanilla records each failed persuasion and refuses that lord until the
    // refusal cools down after one in-game season. Only the machine that ran the
    // conversation records it, so co-op has to decide what a client's list means.
    // (Default) "Vanilla":     a refusal blocks that lord for one in-game season, as in singleplayer.
    // "NeverExpire": a refusal blocks that lord for the rest of the session.
    // "AlwaysRetry": a refusal never blocks; you can ask the same lord again straight away.
    "lordDefectionRetries": "Vanilla",

    // Toggle players being able to execute heroes.
    // Default is false, meaning all executions are blocked.
    "enableHeroExecutions": false,

    // Toggle players being able to execute each others' clan members.
    // This includes player companions and family members.
    // Default is false and won't have any effect if enableHeroExecutions is false.
    "enablePlayerClanMemberExecutions": false,

    // Toggle players being able to execute each other.
    // WARNING: The only requirement for doing this is having another player as prisoner.
    // Default is false and won't have any effect if enableHeroExecutions is false.
    "enablePlayerExecutions": false,

    // Toggle player nameplates in co-op missions.
    // (Default) true: Clients may show nameplates above allied remote players.
    // false: Player nameplates are disabled and the client option is hidden.
    "showPlayerNameplates": true,

    // Toggle players being allowed to join battles when wounded
    // Default is true
    "playerWoundedBattleEntry": true,

    // Set the time in seconds players have to vote on kingdom decisions.
    // Default is 60. Values of 0 or lower will default back to 60.
    "kingdomDecisionVoteTimeoutSeconds": 60,

    // Set what happens to clans when their kingdom is destroyed.
    // "KeepClans": Clans leave the destroyed kingdom and stay alive as independent clans.
    // (Default) "Vanilla": Clans still in a kingdom are destroyed with it, and clans left independent are destroyed after 28 days like vanilla.
    "clansAfterKingdomDestruction": "Vanilla",

    // Players who should host battles, in order of preference, listed by Steam ID.
    // The battle host runs the battle for everyone else, so list players with a fast and stable upload.
    // If a higher-priority player is still loading, the server waits up to 5 seconds for them before picking someone else.
    // (Default) []: The first player to finish loading hosts the battle.
    // e.g. ["76561198000000001", "76561198000000002"]
    "preferredBattleHosts": [],

    // Stop a player caught by an enemy player from leaving.
    // (Default) false: The caught player can pick "I must leave now." whenever the meeting offers it.
    // true: When the two players' factions are at war as the meeting starts, the caught player isn't offered "I must leave now." and the server ignores it.
    // A trade can still be cancelled, and Leave comes back if the two make peace during the meeting, except while answering a hostile demand, which never offers Leave.
    // If the other player then does nothing for 30 seconds (or pvpResponseTimerSeconds when set), the caught player goes free.
    "pvpBlockLeave": false,

    // Set how many real seconds a player has to answer in a meeting with another player.
    // (Default) 0: Off. A player can wait as long as they like, except that with pvpBlockLeave on a caught player goes free after the other player does nothing for 30 seconds.
    // Above 0: A caught player who doesn't answer a demand in time gets the battle, as if they picked refuse, while the two are at war.
    // Any other unanswered meeting just ends, so the timer never starts a war. A player who caught someone and does nothing for this long lets them go.
    // Values from 1 to 9 count as 10. The time starts again after every answer. Trades are never timed.
    "pvpResponseTimerSeconds": 0,

    // Set the most clans one kingdom may have, so one kingdom can't take every clan on a big server.
    // (Default) 0: No limit.
    // Above 0: The ruling clan counts too. A full kingdom can't take a player as a vassal, and its ruler can't recruit another lord or make a companion a lord.
    // The player who asked is told why. Clans already in a kingdom always stay, and new kingdoms and rebellions work as before.
    "maxClansPerKingdom": 0,

    // Count mercenary clans toward maxClansPerKingdom.
    // (Default) false: Mercenaries don't count, so a full kingdom can still hire them and a player can still sign on as one.
    // true: Mercenaries count, and a full kingdom can't take on another mercenary either.
    "maxClansPerKingdomCountsMercenaries": false,

    // Toggle War Sails (NavalDLC) co-op on a dedicated server. War Sails is not officially supported yet.
    // Only the dedicated server reads this. Hosting in game and joining follow the launcher's NavalDLC setting.
    // (Default) false: the dedicated server runs without NavalDLC.
    // true: the dedicated server runs with NavalDLC. Needs a save made with it and a tester build.
    "warSails": false
  }
}
