<Project>
  <PropertyGroup>
    <!-- Bannerlord requires a dotted numeric module version. This also seeds the exact build label
         advertised through Steam; the SDK may append source-revision metadata to that label. -->
    <CoopVersion>0.1.7</CoopVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BannerlordDir)' == ''">
    <!-- Bannerlord install root (holds bin\ and Modules\), from the BANNERLORD_DIR env var that
         runmefirst.cmd sets. -p:BannerlordDir=... overrides it for the build only; GameInterface.Tests still reads
         BANNERLORD_DIR at runtime. Game projects check it in Directory.Build.targets. -->
    <BannerlordDir>$([MSBuild]::EnsureTrailingSlash('$(BANNERLORD_DIR)'))</BannerlordDir>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Whether to build and ship the War Sails (NavalDLC) code. Defaults to whether War Sails is installed;
         pass -p:CoopNavalDlc=false to build as a machine without it would. -->
    <CoopNavalDlc Condition="'$(CoopNavalDlc)' == '' And Exists('$(BannerlordDir)Modules\NavalDLC\bin\Win64_Shipping_Client\NavalDLC.dll')">true</CoopNavalDlc>
    <CoopNavalDlc Condition="'$(CoopNavalDlc)' != 'true'">false</CoopNavalDlc>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
