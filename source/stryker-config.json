{
  "stryker-config": {
    "configuration": "Release",
    "coverage-analysis": "off",
    "reporters": ["html", "json", "progress"],
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "ignore-methods": [
      "*Logger.Verbose",
      "*Logger.Debug",
      "*Logger.Information",
      "*Logger.Warning",
      "*Logger.Error",
      "*Logger.Fatal",
      "*Exception.ctor"
    ]
  }
}
