<Project>
  <!-- Fails a game-referencing project with one clear error when BANNERLORD_DIR is unset, instead of a
       wall of MSB3245/CS0246. Game references are the ones resolved from a Win64_Shipping_Client folder. -->
  <Target Name="CheckBannerlordDir"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(BannerlordDir)' == ''">
    <ItemGroup>
      <_BannerlordGameReference Include="@(Reference)"
                                Condition="$([System.String]::Copy('%(Reference.HintPath)').Contains('Win64_Shipping_Client'))" />
    </ItemGroup>
    <Error Condition="'@(_BannerlordGameReference)' != ''"
           Text="BANNERLORD_DIR is not set; run runmefirst.cmd (or linux-only-runmefirst.sh) to point it at your Bannerlord install, then restart your shell/IDE. $(MSBuildProjectName) references game assemblies from it." />
  </Target>
</Project>
