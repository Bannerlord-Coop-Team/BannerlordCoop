<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
      <Children>
        <Widget Id="CoopChatRoot" WidthSizePolicy="Fixed" SuggestedWidth="520"
                HeightSizePolicy="Fixed" SuggestedHeight="350"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                MarginLeft="27" MarginBottom="100">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.5"
                    IsVisible="@IsOpen" DoNotAcceptEvents="true"/>

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                       MarginLeft="8" MarginRight="8" MarginTop="8" MarginBottom="8"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <ListPanel Id="CoopChatHeader" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                           SuggestedHeight="42" MarginBottom="4"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           IsVisible="@IsOpen">
                  <Children>
                    <ScrollablePanel Id="ChatChannelScrollablePanel" WidthSizePolicy="StretchToParent"
                                     HeightSizePolicy="StretchToParent" AutoHideScrollBars="true"
                                     ClipRect="ChatChannelClipRect"
                                     InnerPanel="ChatChannelClipRect\ChatChannelList"
                                     VerticalScrollbar="..\ChatChannelScrollbar">
                      <Children>
                        <Widget Id="ChatChannelClipRect" WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="ChatChannelList" DataSource="{Channels}"
                                       WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       StackLayout.LayoutMethod="HorizontalLeftToRight">
                              <ItemTemplate>
                                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true"
                                              WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                                              SuggestedHeight="36" MarginRight="6" Brush="Header.Tab.Center"
                                              Command.Click="ExecuteSelection" IsSelected="@IsSelected">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                                MarginLeft="10" MarginRight="10" Brush="Clan.TabControl.Text"
                                                Brush.FontSize="18" Brush.TextHorizontalAlignment="Center"
                                                Brush.TextVerticalAlignment="Center" ClipContents="true"
                                                Text="@Name"/>
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <ScrollbarWidget Id="ChatChannelScrollbar" WidthSizePolicy="Fixed" SuggestedWidth="4"
                                     HeightSizePolicy="StretchToParent" HorizontalAlignment="Right"
                                     AlignmentAxis="Vertical" Handle="ChatChannelScrollbarHandle"
                                     MaxValue="100" MinValue="0" IsVisible="false">
                      <Children>
                        <ImageWidget Id="ChatChannelScrollbarHandle" WidthSizePolicy="Fixed" SuggestedWidth="3"
                                     HeightSizePolicy="Fixed" SuggestedHeight="8" HorizontalAlignment="Center"
                                     Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7"/>
                      </Children>
                    </ScrollbarWidget>
                    <Standard.Button Id="CoopChatMuteButton" WidthSizePolicy="Fixed" SuggestedWidth="90"
                                     HeightSizePolicy="Fixed" SuggestedHeight="36" MarginLeft="4"
                                     Command.Click="ActionToggleMute"
                                     Parameter.Text="@MuteButtonText" IsVisible="@IsMuteButtonVisible"/>
                    <ButtonWidget Id="CoopChatCloseButton" DoNotPassEventsToChildren="true"
                                  UpdateChildrenStates="true" WidthSizePolicy="Fixed" SuggestedWidth="36"
                                  HeightSizePolicy="Fixed" SuggestedHeight="36" MarginLeft="4"
                                  Brush="CloseButton.Flat" Command.Click="ActionClose"/>
                  </Children>
                </ListPanel>

                <Widget Id="CoopChatFeedArea" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" ClipContents="true">
                  <Children>
                    <ScrollablePanel Id="ChatFeedScrollablePanel" WidthSizePolicy="StretchToParent"
                                     HeightSizePolicy="StretchToParent" AutoHideScrollBars="true"
                                     VerticalAlignment="Bottom"
                                     ClipRect="ChatFeedClipRect"
                                     InnerPanel="ChatFeedClipRect\ChatFeedList"
                                     VerticalScrollbar="..\ChatFeedScrollbarHolder\ChatFeedScrollbar">
                      <Children>
                        <Widget Id="ChatFeedClipRect" ClipContents="true"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                MarginLeft="6" MarginRight="21">
                          <Children>
                            <ListPanel Id="ChatFeedList" DataSource="{VisibleLines}"
                                       DoNotAcceptEvents="true"
                                       WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       ClipContents="true"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="CoverChildren" MarginLeft="2" MarginRight="2"
                                                MarginBottom="2" Brush="ChatLog.Text"
                                                Brush.FontColor="@Color" Brush.GlobalAlphaFactor="@Alpha"
                                                Brush.TextHorizontalAlignment="Left"
                                                Brush.TextVerticalAlignment="Center"
                                                Text="@Text" ClipContents="false"/>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <Widget Id="ChatFeedScrollbarHolder" WidthSizePolicy="CoverChildren"
                            HeightSizePolicy="StretchToParent" HorizontalAlignment="Right"
                            IsVisible="@IsOpen">
                      <Children>
                        <ScrollbarWidget Id="ChatFeedScrollbar" WidthSizePolicy="CoverChildren"
                                         HeightSizePolicy="StretchToParent" AlignmentAxis="Vertical"
                                         Handle="ChatFeedScrollbarHandle" MarginTop="12" MarginBottom="5"
                                         MaxValue="100" MinValue="0">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="2" HorizontalAlignment="Center"
                                    Sprite="BlankWhiteSquare_9" Color="#A37434FF" MarginTop="5"
                                    MarginBottom="5" AlphaFactor="0.7"/>
                            <ImageWidget Id="ChatFeedScrollbarHandle" WidthSizePolicy="Fixed"
                                         HeightSizePolicy="Fixed" MinHeight="15" SuggestedHeight="10"
                                         SuggestedWidth="14" HorizontalAlignment="Center"
                                         Brush="SPChatlog.Scrollbar.Handle"/>
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </Widget>
                    <Widget Id="CoopChatUnreadBadge" WidthSizePolicy="Fixed" SuggestedWidth="34"
                            HeightSizePolicy="Fixed" SuggestedHeight="28" HorizontalAlignment="Right"
                            VerticalAlignment="Top" PositionXOffset="-4" PositionYOffset="-4"
                            Sprite="BlankWhiteSquare_9" Color="#B52D24FF"
                            IsVisible="@HasUnreadNotification" DoNotAcceptEvents="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.TabControl.Text" Brush.FontSize="16"
                                    Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center"
                                    Text="@UnreadNotificationText"/>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <ListPanel Id="CoopChatInputRow" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                           SuggestedHeight="44" MarginTop="6"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           IsVisible="@IsOpen">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                 Brush="SaveLoad.Search.Button" UpdateChildrenStates="true">
                      <Children>
                        <EditableTextWidget Id="CoopChatMessageInput" UpdateChildrenStates="true"
                                            WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            MarginLeft="8" MarginRight="8" MarginTop="4" MarginBottom="4"
                                            Brush="SaveLoad.Search.InputText" Brush.FontSize="20"
                                            Text="@WrittenText" MaxLength="@MaxMessageLength"
                                            KeyboardInfoText="@ActiveChannelText"/>
                      </Children>
                    </BrushWidget>
                    <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="90"
                                     HeightSizePolicy="StretchToParent" MarginLeft="6"
                                     Command.Click="ActionSend" Parameter.Text="@SendButtonText"/>
                  </Children>
                </ListPanel>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24"
                            MarginTop="2" Brush="ChatLog.HideShowText"
                            Brush.TextHorizontalAlignment="Right" Brush.TextVerticalAlignment="Center"
                            Text="@InputHintText" IsVisible="@IsOpen"/>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>