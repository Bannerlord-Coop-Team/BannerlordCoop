<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" IsVisible="@IsOpen">
      <Children>
        <DimensionSyncWidget Id="CoopMotdRoot" WidthSizePolicy="Fixed" SuggestedWidth="960" HeightSizePolicy="Fixed" HorizontalAlignment="Center" VerticalAlignment="Center"
                             DimensionToSync="Vertical" WidgetToCopyHeightFrom="Content">
          <Children>
            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Frame1Brush">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#17161380" DoNotAcceptEvents="true"/>
              </Children>
            </BrushWidget>
            <BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="580" HeightSizePolicy="Fixed" SuggestedHeight="116" MarginLeft="12" MarginTop="-24" Brush="Coop.PlayerList.Title.Background" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="74" MarginRight="40" Brush="Coop.PlayerList.Title.Text" Text="@Title" DoNotAcceptEvents="true"/>
              </Children>
            </BrushWidget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginLeft="24" MarginRight="24" MarginTop="104" Sprite="BlankWhiteSquare_9" Color="#AA976038" DoNotAcceptEvents="true"/>
            <ListPanel Id="Content" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="250" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="116" DoNotAcceptEvents="true"/>
                <ScrollablePanel Id="MotdScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="40" MarginRight="48"
                                 AutoHideScrollBars="true" ClipRect="Clip" InnerPanel="Clip\Paragraphs" VerticalScrollbar="..\..\MotdScrollbar">
                  <Children>
                    <Widget Id="Clip" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MaxHeight="420" ClipContents="true">
                      <Children>
                        <ListPanel Id="Paragraphs" DataSource="{Paragraphs}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12" MarginBottom="12" Brush="Coop.PlayerList.Text" Brush.FontSize="24" Brush.TextVerticalAlignment="Top" Text="@Text" DoNotAcceptEvents="true"/>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="84" DoNotAcceptEvents="true"/>
              </Children>
            </ListPanel>
            <ScrollbarWidget Id="MotdScrollbar" WidthSizePolicy="Fixed" SuggestedWidth="16" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginRight="18" MarginTop="118" MarginBottom="86"
                             AlignmentAxis="Vertical" Handle="Handle" MaxValue="100" MinValue="0" Sprite="scrollbar_9">
              <Children>
                <Widget Id="Handle" WidthSizePolicy="Fixed" SuggestedWidth="6" HeightSizePolicy="Fixed" SuggestedHeight="36" MinHeight="20" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#AA9760FF"/>
              </Children>
            </ScrollbarWidget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" VerticalAlignment="Bottom" MarginBottom="66" MarginLeft="24" MarginRight="24" Sprite="BlankWhiteSquare_9" Color="#AA976038" DoNotAcceptEvents="true"/>
            <ButtonWidget Id="MotdClose" WidthSizePolicy="Fixed" SuggestedWidth="160" HeightSizePolicy="Fixed" SuggestedHeight="48" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="26" MarginBottom="8" Brush="ScoreboardUnitRowBrush" Command.Click="ExecuteClose" DoNotPassEventsToChildren="true">
              <Children>
                <InputKeyVisualWidget WidthSizePolicy="Fixed" SuggestedWidth="48" HeightSizePolicy="Fixed" SuggestedHeight="48" KeyID="Escape" DoNotAcceptEvents="true"/>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="58" MarginRight="12" Brush="Coop.PlayerList.Text" Brush.FontSize="23" Text="@CloseText" DoNotAcceptEvents="true"/>
              </Children>
            </ButtonWidget>
          </Children>
        </DimensionSyncWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>
