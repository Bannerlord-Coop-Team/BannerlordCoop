+    [Fact]
+    public void CompletedQuestDoesNotLeakThroughTheLateJoinSaveHistory()
+    {
+        foreach (var instance in Instances)
+            instance.Call(() => new JournalLogsCampaignBehavior().RegisterEvents());
+
+        Accept();
+        Assert.Equal(QuestScenario.ControllerA, scenario.OwnerOnServer());
+        var ownerQuest = (Quest)scenario.QuestOf(ClientA);
+        var serverQuest = (Quest)scenario.QuestOf(Server);
+        Stock(Amount);
+        ClientA.Call(() => ownerQuest.DeliverItemsFullyOnConsequence());
+        ClientA.Call(() => ownerQuest.CompleteQuestWithSuccess());
+
+        Assert.Equal(IssueOutcome.QuestSuccess,
+            Assert.Single(Server.NetworkSentMessages.GetMessages<NetworkIssueFinalized>()).Outcome);
+        ClientA.Call(() => Assert.Single(Campaign.Current.LogEntryHistory.GetGameActionLogs<JournalLogEntry>(
+            entry => entry.IsRelatedTo(ownerQuest) && entry.IsEnded())));
+        ClientB.Call(() => Assert.Empty(Campaign.Current.LogEntryHistory.GetGameActionLogs<JournalLogEntry>(
+            entry => entry.IsEnded())));
+
+        LogEntry[] saveHistory = null!;
+        Server.Call(() => saveHistory = Campaign.Current.LogEntryHistory.GameActionLogs.ToArray());
+        ClientB.Call(() =>
+        {
+            // A join loads the server's saved history before the quest screen reads completed entries.
+            Campaign.Current.LogEntryHistory._logs.Clear();
+            Campaign.Current.LogEntryHistory._logs.AddRange(saveHistory);
+            Assert.Empty(Campaign.Current.LogEntryHistory.GetGameActionLogs<JournalLogEntry>(
+                entry => entry.IsRelatedTo(serverQuest) && entry.IsEnded()));
+        });
+    }
+
